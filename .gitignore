
# macOS Finder metadata, dropped into any directory it touches
.DS_Store

# Playwright MCP scratch (snapshots, console logs) from browser previews
.playwright-mcp/

# working notes, drafts and design records; kept private, never committed
docs/
docs/private-notes/

# selected camera raws, split into main/ and antarctica/; `make develop` reads
# these. Many GB and backed up elsewhere, so never committed.
raw/

# full-size JPEGs developed from raw/ by rawtherapee-cli; the previews are
# rendered from these. A cache, regenerated by `make develop`.
developed/

# generated site: HTML plus the 800/1200/2400 derivative ladder (3600 for bleed
# rows). Whether the derivatives get committed is undecided; if they do, drop
# this line and keep the directory.
site/
