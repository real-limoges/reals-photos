# DSC04039.pp3 --- per-frame override, layered over style/base.pp3.
#
# Translated from the Adobe Camera Raw sidecar
#   ~/Documents/Photos/RAW/2019/2019 - Southern Africa/untitled folder 1/DSC04039.xmp
# matched to raw/ by capture time. Sliders map one to one, as in base.pp3
# (Highlights flips sign). Not carried over: 7 retouch spots; Upright perspective; lens blur; Look 'Adobe Vivid'; Whites +27 / Blacks -31 (base curve kept).

[Exposure]
Compensation=-0.06
Contrast=7
Saturation=17

[Shadows & Highlights]
Highlights=59
Shadows=37

[Vibrance]
Pastels=15

[Dehaze]
Enabled=true
Strength=35
