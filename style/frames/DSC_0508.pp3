# DSC_0508.pp3 --- per-frame override, layered over style/base.pp3.
#
# Translated from the Adobe Camera Raw sidecar
#   ~/Documents/Photos/RAW/_from_lightroom/DSC_0508.xmp
# matched to raw/ by capture time. Sliders map one to one, as in base.pp3
# (Highlights flips sign). Not carried over: Whites -15 / Blacks -30 (base curve kept).

[Exposure]
Compensation=0.08
Contrast=7
Saturation=2

[Shadows & Highlights]
Highlights=12
Shadows=19

[Vibrance]
Pastels=15

[Dehaze]
Enabled=true
Strength=-25
